{
  "apiVersion": "batch/v1",
  "kind": "CronJobList",
  "items": [
    {
      "metadata": {
        "name": "warehouse-backup",
        "namespace": "warehouse",
        "annotations": {
          "cronfold.dev/resource": "warehouse-writer",
          "cronfold.dev/duration-minutes": "25"
        }
      },
      "spec": {
        "schedule": "30 1 * * *",
        "timeZone": "America/New_York",
        "concurrencyPolicy": "Forbid",
        "jobTemplate": {
          "spec": {
            "template": {
              "spec": {
                "restartPolicy": "Never",
                "containers": [
                  {
                    "name": "example",
                    "image": "busybox:1.36.1",
                    "command": [
                      "/bin/echo",
                      "warehouse-backup"
                    ]
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "metadata": {
        "name": "ledger-close",
        "namespace": "warehouse",
        "annotations": {
          "cronfold.dev/resource": "warehouse-writer",
          "cronfold.dev/duration-minutes": "20"
        }
      },
      "spec": {
        "schedule": "40 6 * * *",
        "timeZone": "Etc/UTC",
        "concurrencyPolicy": "Forbid",
        "jobTemplate": {
          "spec": {
            "template": {
              "spec": {
                "restartPolicy": "Never",
                "containers": [
                  {
                    "name": "example",
                    "image": "busybox:1.36.1",
                    "command": [
                      "/bin/echo",
                      "ledger-close"
                    ]
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
